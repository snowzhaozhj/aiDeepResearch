---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const research = await getCollection("research");
  return research.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const base = import.meta.env.BASE_URL;
const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={`${item.data.title} — AI Deep Research`}>
  <nav class="breadcrumb">
    <a href={base}>研究</a>
    <span class="sep">/</span>
    <span class="current">{item.data.title.length > 30 ? item.data.title.slice(0, 30) + '…' : item.data.title}</span>
  </nav>

  <header class="article-header">
    <div class="header-meta">
      <span class={`confidence-indicator ci-${item.data.confidence}`}>
        <span class="ci-dot"></span>
        置信度: {item.data.confidence}
      </span>
      <time class="header-date">
        {item.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
      </time>
    </div>

    <h1 class="article-title">{item.data.title}</h1>

    {item.data.summary && (
      <p class="article-summary">{item.data.summary}</p>
    )}

    <div class="article-meta-bar">
      {item.data.method && (
        <div class="meta-block">
          <span class="meta-label">方法论</span>
          <span class="meta-value">{item.data.method}</span>
        </div>
      )}
      {item.data.tags.length > 0 && (
        <div class="meta-block">
          <span class="meta-label">覆盖领域</span>
          <div class="meta-tags">
            {item.data.tags.map((tag) => (
              <span class="meta-tag">{tag}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </header>

  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    margin-bottom: 2.5rem;
  }
  .breadcrumb a {
    color: var(--muted);
    transition: color 150ms var(--ease);
  }
  .breadcrumb a:hover { color: var(--primary); }
  .sep { color: var(--border); }
  .current { color: var(--ink-2); }

  .article-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .confidence-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .ci-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .ci-high { color: var(--green); }
  .ci-high .ci-dot { background: var(--green); box-shadow: 0 0 10px oklch(0.72 0.16 155 / 0.4); }
  .ci-medium { color: var(--orange); }
  .ci-medium .ci-dot { background: var(--orange); box-shadow: 0 0 10px oklch(0.74 0.14 65 / 0.4); }
  .ci-low { color: var(--red); }
  .ci-low .ci-dot { background: var(--red); box-shadow: 0 0 10px oklch(0.68 0.17 25 / 0.4); }

  .header-date {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--ink);
    margin-bottom: 0.8rem;
    text-wrap: balance;
  }

  .article-summary {
    font-size: 1.125rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 1.2rem 1.4rem;
    background: var(--surface);
    border-radius: var(--r-lg);
    border: 1px solid var(--border-dim);
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .meta-value {
    font-size: 0.8125rem;
    color: var(--ink-2);
    font-family: var(--mono);
    line-height: 1.5;
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .meta-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--primary-dim);
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .article-title { font-size: 1.75rem; }
    .article-summary { font-size: 1rem; }
    .article-meta-bar { flex-direction: column; gap: 1rem; }
  }
</style>
