---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const research = await getCollection("research");
  return research.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const base = import.meta.env.BASE_URL;
const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={`${item.data.title} — AI Deep Research`}>
  <div class="reading-progress" id="reading-progress"></div>

  <nav class="breadcrumb">
    <a href={base}>研究</a>
    <span class="sep">/</span>
    <span class="current">{item.data.title.length > 30 ? item.data.title.slice(0, 30) + '…' : item.data.title}</span>
  </nav>

  <header class="article-header">
    <div class="header-meta">
      <span class={`confidence-indicator ci-${item.data.confidence}`}>
        <span class="ci-dot"></span>
        置信度: {item.data.confidence}
      </span>
      <time class="header-date">
        {item.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
      </time>
    </div>

    <h1 class="article-title">{item.data.title}</h1>

    {item.data.summary && (
      <p class="article-summary">{item.data.summary}</p>
    )}

    <div class="article-meta-bar">
      {item.data.method && (
        <div class="meta-block">
          <span class="meta-label">方法论</span>
          <span class="meta-value">{item.data.method}</span>
        </div>
      )}
      {item.data.tags.length > 0 && (
        <div class="meta-block">
          <span class="meta-label">覆盖领域</span>
          <div class="meta-tags">
            {item.data.tags.map((tag) => (
              <span class="meta-tag">{tag}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </header>

  <div class="article-layout">
    <article class="prose" id="article-content">
      <Content />
    </article>

    <aside class="toc" id="toc">
      <div class="toc-inner">
        <span class="toc-title">目录</span>
        <nav class="toc-nav" id="toc-nav"></nav>
      </div>
    </aside>
  </div>

  <script is:inline>
    (function() {
      var content = document.getElementById('article-content');
      var tocNav = document.getElementById('toc-nav');
      var progressBar = document.getElementById('reading-progress');
      if (!content || !tocNav) return;

      var headings = content.querySelectorAll('h2, h3');
      if (headings.length === 0) return;

      // Generate IDs and TOC links
      var fragment = document.createDocumentFragment();
      headings.forEach(function(h, i) {
        if (!h.id) {
          h.id = 'heading-' + i;
        }
        var link = document.createElement('a');
        link.href = '#' + h.id;
        link.textContent = h.textContent;
        link.className = 'toc-link toc-' + h.tagName.toLowerCase();
        link.addEventListener('click', function(e) {
          e.preventDefault();
          h.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + h.id);
        });
        fragment.appendChild(link);
      });
      tocNav.appendChild(fragment);

      // IntersectionObserver for active heading
      var links = tocNav.querySelectorAll('.toc-link');
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            links.forEach(function(l) { l.classList.remove('active'); });
            var active = tocNav.querySelector('a[href="#' + entry.target.id + '"]');
            if (active) active.classList.add('active');
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

      headings.forEach(function(h) { observer.observe(h); });

      // Reading progress bar
      if (progressBar) {
        window.addEventListener('scroll', function() {
          var scrollTop = window.scrollY;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          progressBar.style.width = progress + '%';
        }, { passive: true });
      }
    })();
  </script>
</Base>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--primary);
    z-index: 200;
    transition: width 50ms linear;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    margin-bottom: 2.5rem;
  }
  .breadcrumb a {
    color: var(--muted);
    transition: color 150ms var(--ease);
  }
  .breadcrumb a:hover { color: var(--primary); }
  .sep { color: var(--border); }
  .current { color: var(--ink-2); }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .confidence-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .ci-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .ci-high { color: var(--green); }
  .ci-high .ci-dot { background: var(--green); box-shadow: 0 0 10px var(--green-dim); }
  .ci-medium { color: var(--orange); }
  .ci-medium .ci-dot { background: var(--orange); box-shadow: 0 0 10px var(--orange-dim); }
  .ci-low { color: var(--red); }
  .ci-low .ci-dot { background: var(--red); box-shadow: 0 0 10px var(--red-dim); }

  .header-date {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--ink);
    margin-bottom: 0.8rem;
    text-wrap: balance;
  }

  .article-summary {
    font-size: 1.125rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 1.2rem 1.4rem;
    background: var(--surface);
    border-radius: var(--r-lg);
    border: 1px solid var(--border-dim);
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .meta-value {
    font-size: 0.8125rem;
    color: var(--ink-2);
    font-family: var(--mono);
    line-height: 1.5;
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .meta-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--primary-dim);
    color: var(--primary);
  }

  /* ── Article layout with TOC ── */
  .article-layout {
    position: relative;
  }

  .toc {
    position: fixed;
    top: 80px;
    right: max(1rem, calc((100vw - 900px) / 2 - 240px));
    width: 200px;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .toc-inner {
    padding: 0.8rem 0;
  }

  .toc-title {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.6rem;
    padding-left: 0.75rem;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
  }

  .toc-nav :global(.toc-link) {
    display: block;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--muted);
    text-decoration: none;
    padding: 0.25rem 0.75rem;
    border-left: 2px solid transparent;
    transition: all 150ms var(--ease);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-nav :global(.toc-link:hover) {
    color: var(--ink-2);
  }

  .toc-nav :global(.toc-link.active) {
    color: var(--primary);
    border-left-color: var(--primary);
  }

  .toc-nav :global(.toc-h3) {
    padding-left: 1.4rem;
    font-size: 0.6875rem;
  }

  /* Hide TOC on narrow viewports */
  @media (max-width: 1280px) {
    .toc { display: none; }
  }

  @media (max-width: 768px) {
    .article-title { font-size: 1.75rem; }
    .article-summary { font-size: 1rem; }
    .article-meta-bar { flex-direction: column; gap: 1rem; }
  }
</style>
