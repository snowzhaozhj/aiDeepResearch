---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const tools = await getCollection("tools");
const base = import.meta.env.BASE_URL;

const categories: Record<string, string> = {
  evaluation: "评估体系",
  frameworks: "Agent 框架",
  protocols: "协议",
  observability: "可观测性",
  toolchain: "工具链",
};

const grouped = Object.entries(categories)
  .map(([key, label]) => ({
    key,
    label,
    tools: tools.filter((t) => t.data.category === key),
  }))
  .filter((g) => g.tools.length > 0);
---

<Base title="工具目录 — Harness Lab">
  <div class="page-head">
    <h1 class="t-title">工具目录</h1>
    <p class="t-body" style="color:var(--muted)">按主题浏览已分析的工具</p>
  </div>

  {grouped.map((group) => (
    <section class="cat-group">
      <div class="cat-label">{group.label}</div>
      <div class="cat-tools">
        {group.tools.map((tool) => (
          <a class="tool-item" href={`${base}tools/${tool.id}/`}>
            <div>
              <div class="ti-name">
                {tool.data.name}
                {tool.data.status !== "active" && (
                  <span class={`badge badge-${tool.data.status}`} style="margin-left:0.4rem;font-size:0.625rem;">
                    {tool.data.status.toUpperCase()}
                  </span>
                )}
              </div>
              <div class="ti-desc">{tool.data.summary}</div>
            </div>
            <div class="ti-meta">
              <span class={`badge badge-${tool.data.confidence}`}>{tool.data.confidence.toUpperCase()}</span>
              {tool.data.stars && <span class="stars-count">★ {(tool.data.stars / 1000).toFixed(1)}k</span>}
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .page-head { margin-bottom: 2rem; }
  .page-head .t-title { margin-bottom: 0.3rem; }

  .cat-group { margin-bottom: 2.5rem; }
  .cat-label {
    font-size: 0.6875rem; font-weight: 600;
    letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--muted); padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--ink); margin-bottom: 0;
    display: inline-block;
  }

  .tool-item {
    display: grid; grid-template-columns: 1fr auto;
    align-items: baseline; gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border-dim);
    text-decoration: none; color: inherit;
    transition: background 120ms var(--ease);
  }
  .tool-item:hover { background: oklch(0.15 0.01 265 / 0.02); margin: 0 -0.5rem; padding-left: 0.5rem; padding-right: 0.5rem; border-radius: var(--r); text-decoration: none; }
  .ti-name { font-weight: 600; font-size: 0.9375rem; color: var(--ink); }
  .ti-desc { font-size: 0.8125rem; color: var(--muted); margin-top: 0.05rem; max-width: 55ch; }
  .ti-meta { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .stars-count { font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
