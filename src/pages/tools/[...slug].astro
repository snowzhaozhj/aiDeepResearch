---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const categoryLabels: Record<string, string> = {
  evaluation: "评估体系",
  frameworks: "Agent 框架",
  protocols: "协议",
  observability: "可观测性",
  toolchain: "工具链",
};

const base = import.meta.env.BASE_URL;
const { tool } = Astro.props;
const { Content } = await render(tool);
---

<Base title={`${tool.data.name} — Harness Lab`}>
  <a class="back-link" href={`${base}tools/`}>← 工具目录</a>

  <div class="detail-head">
    <h1 class="t-display">{tool.data.name}</h1>
    <p class="tagline">{tool.data.summary}</p>
    <div class="meta-row">
      <span class={`badge badge-${tool.data.confidence}`}>{tool.data.confidence.toUpperCase()}</span>
      <span class={`badge badge-${tool.data.status}`}>{tool.data.status.toUpperCase()}</span>
      <span class="meta-tag">{categoryLabels[tool.data.category]}</span>
      {tool.data.repo && (
        <span class="meta-tag"><a href={tool.data.repo} target="_blank">GitHub →</a></span>
      )}
      {tool.data.stars && (
        <span class="meta-tag">★ {(tool.data.stars / 1000).toFixed(1)}k</span>
      )}
      {tool.data.tags.map((tag) => (
        <span class="meta-tag">{tag}</span>
      ))}
    </div>
  </div>

  <div class="prose">
    <Content />
  </div>
</Base>

<style>
  .back-link {
    font-size: 0.8125rem; color: var(--muted);
    margin-bottom: 2rem; display: inline-flex;
    align-items: center; gap: 0.3rem;
    transition: color 150ms var(--ease);
  }
  .back-link:hover { color: var(--primary); text-decoration: none; }

  .detail-head { margin-bottom: 3rem; }
  .detail-head .t-display { margin-bottom: 0.5rem; }
  .tagline {
    font-size: 1.0625rem; color: var(--ink-2);
    max-width: 58ch; line-height: 1.65; margin-bottom: 1.2rem;
  }
  .meta-row { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .meta-tag {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.2rem 0.5rem; border-radius: 20px;
    font-size: 0.75rem; background: var(--surface);
    color: var(--muted); border: 1px solid var(--border);
  }
  .meta-tag a { font-size: 0.75rem; }
</style>
