---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const research = await getCollection("research");
const sorted = research.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL;

const allTags = [...new Set(sorted.flatMap((r) => r.data.tags))].sort();
const [latest, ...rest] = sorted;
---

<Base title="AI Deep Research">
  <section class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        AI 工具生态<span class="title-accent">深度研究</span>
      </h1>
      <p class="page-desc">
        每个结论经过多源对抗验证，每个推荐标注置信度和依据。
      </p>
    </div>
    <div class="header-stat">
      <span class="stat-number">{sorted.length}</span>
      <span class="stat-label">篇研究</span>
    </div>
  </section>

  {latest && (
    <section class="latest-section">
      <div class="section-label">最新研究</div>
      <a class="latest-card" href={`${base}research/${latest.id}/`}>
        <div class="latest-content">
          <div class="latest-meta">
            <span class={`confidence-indicator ci-${latest.data.confidence}`}>
              <span class="ci-dot"></span>
              {latest.data.confidence}
            </span>
            <time class="card-date">
              {latest.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "short", day: "numeric" })}
            </time>
          </div>
          <h2 class="latest-title">{latest.data.title}</h2>
          <p class="latest-summary">{latest.data.summary}</p>
          <div class="latest-footer">
            <div class="card-tags">
              {latest.data.tags.slice(0, 4).map((tag) => (
                <span class="card-tag">{tag}</span>
              ))}
            </div>
            {latest.data.method && <span class="method-text">{latest.data.method}</span>}
          </div>
        </div>
        <div class="latest-arrow">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="archive-section">
      <div class="archive-header">
        <div class="section-label">全部研究</div>
        <div class="tag-filter" id="tag-filter">
          <button class="filter-tag active" data-tag="all">全部</button>
          {allTags.map((tag) => (
            <button class="filter-tag" data-tag={tag}>{tag}</button>
          ))}
        </div>
      </div>

      <div class="archive-grid" id="archive-grid">
        {rest.map((item, i) => (
          <a
            class="archive-card"
            href={`${base}research/${item.id}/`}
            data-tags={item.data.tags.join(",")}
            style={`--delay: ${i * 50}ms`}
          >
            <div class="archive-top">
              <span class={`confidence-indicator ci-${item.data.confidence}`}>
                <span class="ci-dot"></span>
                {item.data.confidence}
              </span>
              <time class="card-date">
                {item.data.date.toLocaleDateString("zh-CN", { month: "short", day: "numeric" })}
              </time>
            </div>
            <h3 class="archive-title">{item.data.title}</h3>
            <p class="archive-summary">{item.data.summary}</p>
            <div class="card-tags">
              {item.data.tags.slice(0, 3).map((tag) => (
                <span class="card-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script is:inline>
  (function () {
    var filter = document.getElementById("tag-filter");
    var grid = document.getElementById("archive-grid");
    if (!filter || !grid) return;

    filter.addEventListener("click", function (e) {
      var btn = e.target.closest(".filter-tag");
      if (!btn) return;

      filter.querySelectorAll(".filter-tag").forEach(function (b) {
        b.classList.remove("active");
      });
      btn.classList.add("active");

      var tag = btn.getAttribute("data-tag");
      grid.querySelectorAll(".archive-card").forEach(function (card) {
        if (tag === "all" || card.getAttribute("data-tags").split(",").indexOf(tag) !== -1) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  })();
</script>

<style>
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 2.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .title-accent {
    color: var(--primary);
    margin-left: 0.15em;
  }

  .page-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin-top: 0.4rem;
    max-width: 44ch;
    line-height: 1.6;
  }

  .header-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  /* ── Section label ── */

  .section-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  /* ── Latest card ── */

  .latest-section {
    margin-bottom: 3rem;
  }

  .latest-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem 2rem;
    background: var(--surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--r-lg);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms var(--ease), background 200ms var(--ease);
  }
  .latest-card:hover {
    border-color: var(--primary);
    background: var(--surface-2);
    color: inherit;
  }

  .latest-content {
    flex: 1;
    min-width: 0;
  }

  .latest-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .latest-title {
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: color 150ms var(--ease);
  }
  .latest-card:hover .latest-title {
    color: var(--primary);
  }

  .latest-summary {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 65ch;
    margin-bottom: 0.8rem;
  }

  .latest-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .latest-arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--primary-dim);
    color: var(--primary);
    transition: all 200ms var(--ease);
  }
  .latest-card:hover .latest-arrow {
    background: var(--primary);
    color: var(--bg);
    transform: translateX(2px);
  }

  /* ── Archive section ── */

  .archive-section {
    padding-top: 0.5rem;
  }

  .archive-header {
    margin-bottom: 1rem;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .filter-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--border-dim);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 150ms var(--ease);
  }
  .filter-tag:hover {
    color: var(--ink);
    border-color: var(--border);
  }
  .filter-tag.active {
    background: var(--primary-dim);
    color: var(--primary);
    border-color: transparent;
  }

  /* ── Archive grid ── */

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1px;
    background: var(--border-dim);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .archive-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: background 200ms var(--ease);
    animation: card-in 400ms var(--ease) var(--delay, 0ms) both;
  }
  .archive-card:hover {
    background: var(--surface-2);
    color: inherit;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .archive-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .archive-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
    line-height: 1.35;
    transition: color 150ms var(--ease);
  }
  .archive-card:hover .archive-title {
    color: var(--primary);
  }

  .archive-summary {
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 0.7rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Shared ── */

  .confidence-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ci-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .ci-high { color: var(--green); }
  .ci-high .ci-dot { background: var(--green); box-shadow: 0 0 8px var(--green-dim); }
  .ci-medium { color: var(--orange); }
  .ci-medium .ci-dot { background: var(--orange); box-shadow: 0 0 8px var(--orange-dim); }
  .ci-low { color: var(--red); }
  .ci-low .ci-dot { background: var(--red); box-shadow: 0 0 8px var(--red-dim); }

  .card-date {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .card-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
    border: 1px solid var(--border-dim);
  }

  .method-text {
    font-size: 0.75rem;
    color: var(--muted);
    font-family: var(--mono);
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 0 2rem;
    }
    .header-stat {
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
    }
    .stat-number { font-size: 1.5rem; }
    .page-title { font-size: 1.5rem; }
    .latest-card {
      flex-direction: column;
      padding: 1.25rem;
      gap: 1rem;
    }
    .latest-arrow { display: none; }
    .latest-title { font-size: 1.2rem; }
    .archive-grid {
      grid-template-columns: 1fr;
    }
    .archive-card { padding: 1rem; }
    .tag-filter { gap: 0.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-card { animation: none; }
  }
</style>
