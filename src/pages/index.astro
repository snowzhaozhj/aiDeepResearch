---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const research = await getCollection("research");
const sorted = research.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL;
---

<Base title="AI Deep Research">
  <section class="page-header">
    <h1 class="page-title">深度研究</h1>
    <p class="page-desc">
      系统性分析 AI 开发生态中的工具与框架。每个结论经过多源对抗验证，标注置信度和依据。
    </p>
  </section>

  <div class="research-list">
    {sorted.map((item, i) => {
      const isFirst = i === 0;
      return (
        <a
          class:list={["research-item", { "research-item--featured": isFirst }]}
          href={`${base}research/${item.id}/`}
          style={`--delay: ${i * 40}ms`}
        >
          <div class="item-header">
            <span class={`ci ci-${item.data.confidence}`}>
              <span class="ci-dot" />
              {item.data.confidence}
            </span>
            <time class="item-date">
              {item.data.date.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </div>

          <h2 class="item-title">{item.data.title}</h2>

          <p class="item-summary">{item.data.summary}</p>

          <div class="item-footer">
            {item.data.method && (
              <span class="item-method">{item.data.method}</span>
            )}
          </div>
        </a>
      );
    })}
  </div>
</Base>

<style>
  .page-header {
    padding: 1rem 0 2.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 750;
    letter-spacing: -0.025em;
    color: var(--ink);
    line-height: 1.2;
    margin-bottom: 0.4rem;
  }

  .page-desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 52ch;
  }

  /* ── Research list ── */

  .research-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--border-dim);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .research-item {
    display: block;
    padding: 1.5rem 1.75rem;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: background 180ms var(--ease);
    animation: item-in 350ms var(--ease) var(--delay, 0ms) both;
  }

  .research-item + .research-item {
    border-top: 1px solid var(--border-dim);
  }

  .research-item:hover {
    background: var(--surface-2);
    color: inherit;
  }

  .research-item--featured {
    padding: 2rem 1.75rem;
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  /* ── Item internals ── */

  .item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .ci {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .ci-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .ci-high { color: var(--green); }
  .ci-high .ci-dot { background: var(--green); }
  .ci-medium { color: var(--orange); }
  .ci-medium .ci-dot { background: var(--orange); }
  .ci-low { color: var(--red); }
  .ci-low .ci-dot { background: var(--red); }

  .item-date {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .item-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-bottom: 0.4rem;
    transition: color 150ms var(--ease);
  }

  .research-item--featured .item-title {
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .research-item:hover .item-title {
    color: var(--primary);
  }

  .item-summary {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 65ch;
  }

  .research-item:not(.research-item--featured) .item-summary {
    font-size: 0.875rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-footer {
    margin-top: 0.6rem;
    min-height: 1rem;
  }

  .item-method {
    font-size: 0.75rem;
    color: var(--muted);
    font-family: var(--mono);
  }

  /* ── Responsive ── */

  @media (max-width: 768px) {
    .page-title { font-size: 1.5rem; }
    .research-item { padding: 1.25rem 1rem; }
    .research-item--featured { padding: 1.5rem 1rem; }
    .research-item--featured .item-title { font-size: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-item { animation: none; }
  }
</style>
