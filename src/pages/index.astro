---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const research = await getCollection("research");
const sorted = research.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL;
---

<Base title="AI Deep Research">
  <div class="home-intro">
    <h1 class="t-display">AI Deep Research</h1>
    <p class="lead">
      系统性的深度研究，有观点的技术分析。每个结论经过对抗验证，每个推荐标注置信度。
    </p>
  </div>

  <section class="research-list">
    <h2 class="t-heading">研究项目</h2>
    <div class="entries">
      {sorted.map((item) => (
        <a class="entry" href={`${base}research/${item.id}/`}>
          <div class="entry-date">
            {item.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
          </div>
          <div class="entry-body">
            <h3 class="entry-title">{item.data.title}</h3>
            <p class="entry-summary">{item.data.summary}</p>
            <div class="entry-tags">
              {item.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
              <span class={`badge badge-${item.data.confidence}`}>{item.data.confidence.toUpperCase()}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .home-intro { margin-bottom: 3rem; }
  .home-intro .t-display { margin-bottom: 0.5rem; }
  .lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    max-width: 55ch;
    line-height: 1.65;
  }

  .research-list .t-heading { margin-bottom: 1.2rem; }

  .entries { display: flex; flex-direction: column; }

  .entry {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1.5rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--border-dim);
    text-decoration: none;
    color: inherit;
    transition: background 120ms var(--ease);
  }
  .entry:first-child { border-top: 1px solid var(--border-dim); }
  .entry:hover { background: oklch(0.15 0.01 265 / 0.02); text-decoration: none; }

  .entry-date {
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .entry-title {
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--ink);
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }

  .entry-summary {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 0.6rem;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
  }

  .tag {
    font-size: 0.6875rem;
    padding: 0.12rem 0.4rem;
    border-radius: 3px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
  }
</style>
