---
interface Props {
  events: { date: string; title: string; detail?: string; type?: "default" | "highlight" | "warning" }[];
}

const { events } = Astro.props;
---

<div class="timeline">
  {events.map((ev) => (
    <div class={`tl-item tl-${ev.type || "default"}`}>
      <div class="tl-marker">
        <span class="tl-dot"></span>
        <span class="tl-line"></span>
      </div>
      <div class="tl-content">
        <time class="tl-date">{ev.date}</time>
        <p class="tl-title">{ev.title}</p>
        {ev.detail && <p class="tl-detail">{ev.detail}</p>}
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    margin: 2rem 0;
    padding-left: 0.5rem;
  }

  .tl-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 1rem;
    min-height: 4rem;
  }

  .tl-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.3rem;
  }

  .tl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
    flex-shrink: 0;
    transition: all 200ms var(--ease);
  }

  .tl-line {
    width: 1px;
    flex: 1;
    background: var(--border-dim);
    margin-top: 4px;
  }

  .tl-item:last-child .tl-line {
    display: none;
  }

  .tl-highlight .tl-dot {
    background: var(--primary);
    box-shadow: 0 0 8px var(--primary-glow);
  }

  .tl-warning .tl-dot {
    background: var(--orange);
    box-shadow: 0 0 8px var(--orange-dim);
  }

  .tl-content {
    padding-bottom: 1.5rem;
  }

  .tl-date {
    font-size: 0.6875rem;
    font-family: var(--mono);
    color: var(--muted);
    display: block;
    margin-bottom: 0.2rem;
  }

  .tl-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
    margin: 0;
  }

  .tl-highlight .tl-title {
    color: var(--primary);
  }

  .tl-detail {
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0.3rem 0 0;
  }
</style>
