---
import "../styles/global.css";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
}

const { title = "AI Deep Research" } = Astro.props;
const base = import.meta.env.BASE_URL;
const research = await getCollection("research");
const sorted = research.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <div class="brand-mark">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="3" fill="currentColor" />
              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5" opacity="0.4" />
            </svg>
          </div>
          <span class="brand-text">Deep Research</span>
        </a>

        <div class="topbar-right">
          <nav class="nav">
            {sorted.slice(0, 5).map((item) => (
              <a class="nav-link" href={`${base}research/${item.id}/`}>
                {item.data.title.length > 14 ? item.data.title.slice(0, 14) + '…' : item.data.title}
              </a>
            ))}
          </nav>

          <button class="theme-toggle" id="theme-toggle" aria-label="切换主题">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <span class="footer-text">有观点的技术研究，每个结论标注置信度</span>
      </footer>
    </div>

    <script is:inline>
      (function() {
        var btn = document.getElementById('theme-toggle');
        btn.addEventListener('click', function() {
          var isDark = document.documentElement.hasAttribute('data-theme');
          if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      })();
    </script>

    <style>
      .shell {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
        height: 56px;
        border-bottom: 1px solid var(--border-dim);
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 100;
        transition: background 300ms var(--ease), border-color 300ms var(--ease);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
        text-decoration: none;
      }
      .brand:hover { color: var(--ink); }

      .brand-mark {
        color: var(--primary);
        display: flex;
        align-items: center;
      }

      .brand-text {
        font-weight: 700;
        font-size: 0.9375rem;
        letter-spacing: -0.02em;
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .nav {
        display: flex;
        gap: 0.2rem;
      }

      .nav-link {
        font-size: 0.8125rem;
        color: var(--muted);
        padding: 0.35rem 0.7rem;
        border-radius: 6px;
        transition: all 150ms var(--ease);
        text-decoration: none;
      }
      .nav-link:hover {
        color: var(--ink);
        background: var(--surface);
      }

      .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid var(--border-dim);
        background: var(--surface);
        color: var(--ink-2);
        cursor: pointer;
        transition: all 150ms var(--ease);
        margin-left: 0.5rem;
      }
      .theme-toggle:hover {
        color: var(--ink);
        border-color: var(--border);
        background: var(--surface-2);
      }

      .icon-moon { display: none; }
      :global([data-theme="dark"]) .icon-sun { display: none; }
      :global([data-theme="dark"]) .icon-moon { display: block; }

      .main {
        flex: 1;
        padding: 3.5rem 2rem 5rem;
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
      }

      .footer {
        border-top: 1px solid var(--border-dim);
        padding: 1.5rem 2rem;
        text-align: center;
        transition: border-color 300ms var(--ease);
      }
      .footer-text {
        font-size: 0.8125rem;
        color: var(--muted);
      }

      @media (max-width: 768px) {
        .topbar { padding: 0 1rem; }
        .nav { display: none; }
        .main { padding: 2rem 1.25rem 4rem; }
      }
    </style>
  </body>
</html>
