---
import "../styles/global.css";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
}

const { title = "AI Deep Research" } = Astro.props;
const base = import.meta.env.BASE_URL;
const research = await getCollection("research");
const sorted = research.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <div class="brand-mark">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="3" fill="currentColor" />
              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5" opacity="0.4" />
            </svg>
          </div>
          <span class="brand-text">Deep Research</span>
        </a>

        <nav class="nav">
          {sorted.slice(0, 5).map((item) => (
            <a class="nav-link" href={`${base}research/${item.id}/`}>
              {item.data.title.length > 14 ? item.data.title.slice(0, 14) + '…' : item.data.title}
            </a>
          ))}
        </nav>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <span class="footer-text">有观点的技术研究，每个结论标注置信度</span>
      </footer>
    </div>

    <style>
      .shell {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
        height: 56px;
        border-bottom: 1px solid var(--border-dim);
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
        text-decoration: none;
      }
      .brand:hover { color: var(--ink); }

      .brand-mark {
        color: var(--primary);
        display: flex;
        align-items: center;
      }

      .brand-text {
        font-weight: 700;
        font-size: 0.9375rem;
        letter-spacing: -0.02em;
      }

      .nav {
        display: flex;
        gap: 0.2rem;
      }

      .nav-link {
        font-size: 0.8125rem;
        color: var(--muted);
        padding: 0.35rem 0.7rem;
        border-radius: 6px;
        transition: all 150ms var(--ease);
        text-decoration: none;
      }
      .nav-link:hover {
        color: var(--ink);
        background: var(--surface);
      }

      .main {
        flex: 1;
        padding: 3.5rem 2rem 5rem;
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
      }

      .footer {
        border-top: 1px solid var(--border-dim);
        padding: 1.5rem 2rem;
        text-align: center;
      }
      .footer-text {
        font-size: 0.8125rem;
        color: var(--muted);
      }

      @media (max-width: 768px) {
        .topbar { padding: 0 1rem; }
        .nav { display: none; }
        .main { padding: 2rem 1.25rem 4rem; }
      }
    </style>
  </body>
</html>
